# No paid provider calls occur in demo mode.
DEEPLAKE_DATA_DIR=.deeplake
# Set this for separate production API/worker processes. Leave empty for local PGlite.
DATABASE_URL=
POSTGRES_PASSWORD=replace-with-a-random-database-password
DEEPLAKE_API_TOKEN=replace-with-a-random-token-at-least-24-characters
DEEPLAKE_HOST=127.0.0.1
DEEPLAKE_PORT=4310
DEEPLAKE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:4173
EXA_API_KEY=
EXA_SEARCH_MODE=auto
# Optional source-text fallback only after eligible HTTP 5xx origin failures.
EXA_CONTENTS_FALLBACK=false
BRAVE_API_KEY=
SEARCH_PROVIDER=exa
ANTHROPIC_API_KEY=
MODEL_PLANNER=claude-haiku-5-5
MODEL_ARCHITECT=claude-opus-5-5
MODEL_AUDITOR=claude-sonnet-5-5
MODEL_RESOLVER=claude-sonnet-5-5
# Conservative configurable cost estimates. Actual provider usage is stored separately.
LLM_INPUT_USD_PER_MILLION=4
LLM_OUTPUT_USD_PER_MILLION=20
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLAIRIC_INPUT_USD_PER_MILLION=0.10
DEEPLAKE_USER_AGENT=Deeplake/0.1 (configure-your-contact-url)
